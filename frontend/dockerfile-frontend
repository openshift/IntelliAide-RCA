# Local OpenShift deploy only — ./k8s/deploy-openshift.sh
# Build from repo root: podman build -f frontend/dockerfile-frontend -t <tag> .
# Konflux uses frontend/Dockerfile (UBI) — see docs/reference/FRONTEND_DOCKER_TLDR.md
FROM node:20-alpine AS build

WORKDIR /app
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend/ .
COPY content/ /content/
RUN npm run build

FROM nginxinc/nginx-unprivileged:alpine

COPY --from=build /app/dist /usr/share/nginx/html
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 8080
